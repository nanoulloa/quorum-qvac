{
  "name": "@quorum/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "eval:extraccion": "tsx scripts/eval-extraccion.ts",
    "eval:voz": "tsx scripts/eval-voz.ts",
    "placas:generar": "python3 scripts/generar-placas.py",
    "eval:placas": "tsx scripts/eval-placas.ts",
    "eval:consultas": "tsx scripts/eval-consultas.ts",
    "prueba:p2p": "tsx scripts/prueba-p2p.ts",
    "prueba:sin-red": "sandbox-exec -f scripts/sin-red.sb tsx scripts/prueba-sin-red.ts",
    "perf:resumen": "tsx scripts/resumen-perf.ts",
    "test": "tsx --test src/**/*.test.ts",
    "semilla": "curl -s -X POST http://127.0.0.1:${QUORUM_API_PORT:-4000}/api/semilla",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@quorum/shared": "*",
    "@qvac/sdk": "^0.19.0",
    "compact-encoding": "^3.5.0",
    "corestore": "^7.12.5",
    "fastify": "^5.1.0",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.1",
    "protomux": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2"
  }
}
